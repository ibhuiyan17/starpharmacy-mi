# Copy this file to `.env.local` and fill in values to enable server-side
# email for the contact form. If these are left unset, the contact form
# still works — it falls back to opening the visitor's email app (mailto).

# SendGrid (https://sendgrid.com) — for sending contact-form emails:
SENDGRID_API_KEY=
SENDGRID_TO=starpharmacymi@gmail.com
SENDGRID_FROM=   # must be a SendGrid-verified sender address
