# Copy this file to `.env.local` and fill in values. Everything is OPTIONAL:
# with nothing set, the contact and transfer forms still work by falling back
# to opening the visitor's email app (mailto). Set these to automate.

# ---------------------------------------------------------------------------
# 1) EMAIL (active path today) — SendGrid
#    Sends contact + transfer requests to the pharmacy inbox.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_TO=starpharmacymi@gmail.com
SENDGRID_FROM=            # a SendGrid-verified sender address

# ---------------------------------------------------------------------------
# 2) WEBHOOK (recommended automation path — turn on when ready)
#    Point this at a HIPAA-compliant automation platform (BAA in place) that
#    receives transfer requests and drops them into a "Pending Approvals"
#    queue for staff. When set, the transfer pipeline POSTs to it automatically
#    — no code change. If a secret is set, payloads are signed with
#    HMAC-SHA256 in the `X-Signature` header so the receiver can verify them.
# ---------------------------------------------------------------------------
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 3) RxQ BRIDGE (full automation — DISABLED until legal sign-off)
#    ⚠️  Do NOT point this at the raw RxQ terminal/database. It must be a
#    certified, BAA-covered integration bridge (e.g. a Liberty Software
#    integration partner) that lands requests in a Pending Approvals queue.
#    Requires INTAKE_RXQ_ENABLED=true to activate.
#    Generate the RxQ key from the store computer:
#      System > Settings > Utilities > API Keys > Add New Key
#    Treat RXQ_API_KEY like a master password — server-side secret ONLY,
#    never exposed to the browser.
# ---------------------------------------------------------------------------
INTAKE_RXQ_ENABLED=false
INTAKE_RXQ_ENDPOINT=
RXQ_API_KEY=
